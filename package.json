{
  "name": "dxp-loadtest",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only load testing for the DXP retailer portal (k6 API load + Playwright browser layer).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lt": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "mock": "tsx mock/server.ts"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
