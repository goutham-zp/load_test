# Test users (MFA must be off). Add LT_USER_5_*, LT_USER_6_* ... if you get more users.
LT_USER_1_EMAIL=
LT_USER_1_PASSWORD=
LT_USER_2_EMAIL=
LT_USER_2_PASSWORD=
LT_USER_3_EMAIL=
LT_USER_3_PASSWORD=
LT_USER_4_EMAIL=
LT_USER_4_PASSWORD=

# FMS_UI users (envs with "userPrefix": "LT_FMS_USER_", e.g. pg-fms): Auth0 users, MFA off.
LT_FMS_USER_1_EMAIL=
LT_FMS_USER_1_PASSWORD=
LT_FMS_USER_2_EMAIL=
LT_FMS_USER_2_PASSWORD=
# FMS_UI on dev with the Oracle backend: one env per role. Add _2, _3, ... for more accounts of the same role.
# env ora-dev-fms-retailer ("userPrefix": "LT_FMSORADEV_RET_USER_")
LT_FMSORADEV_RET_USER_1_EMAIL=
LT_FMSORADEV_RET_USER_1_PASSWORD=
# env ora-dev-fms-distributor ("userPrefix": "LT_FMSORADEV_DIST_USER_")
LT_FMSORADEV_DIST_USER_1_EMAIL=
LT_FMSORADEV_DIST_USER_1_PASSWORD=
# DXP retailer portal on dev with the Oracle backend: env ora-dev-dxp ("userPrefix": "LT_DXPDEV_USER_"), fintech-dev Auth0.
# (env pg-uat-dxp, its Postgres counterpart on test-dxp, uses LT_USER_<n>_* above.)
LT_DXPDEV_USER_1_EMAIL=
LT_DXPDEV_USER_1_PASSWORD=
